# ==========================================
# KP Wholesale Auth & Registration App Config
# ==========================================

# 1. Server Configuration
PORT=3000
NODE_ENV=production
APP_URL=https://auth.kpsonswholesale.com

# 2. PostgreSQL Connection
# postgresql://<user>:<password>@<host>:5432/<database>?schema=public
# Create the tables once with:  npx prisma migrate deploy
DATABASE_URL=postgresql://kp_app:password@localhost:5432/kp_wholesale?schema=public

# 3. Security & Authentication
# Generate a strong 64-character secret using: openssl rand -base64 32
JWT_SECRET=super_secret_jwt_signing_key_replace_me_in_production
CSRF_SECRET=super_secret_csrf_signing_key_replace_me_in_production
# Both secrets must be 32+ characters; the app refuses to start in production otherwise.

# Storefront origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=https://kpsonswholesale.com,https://www.kpsonswholesale.com,https://ujwt36-mq.myshopify.com

# 4. File Upload Storage (VPS Local Path)
# Directory where uploaded licenses and documents will be saved.
# Must NOT be inside public/ (that would make documents publicly downloadable).
UPLOAD_DIR=/var/www/kp-app/storage/uploads

# 5. Shopify Admin API Integration
# Store domain (e.g. ujwt36-mq.myshopify.com)
SHOPIFY_STORE_DOMAIN=ujwt36-mq.myshopify.com
# Dev Dashboard app (dev.shopify.com) installed on the store, with the
# read_customers and write_customers scopes. The app fetches and renews its own
# access token from these.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Alternative: a legacy shpat_ token from an app made in Settings > Apps > Develop apps
# before 2026 (leave blank when using the client ID/secret above).
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10

# 6. Email Notifications (Resend - https://resend.com)
# Admin alert on new applications, and approval / rejection emails to retailers.
# API key: Resend > API Keys (sending access is enough).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must use a domain you have verified in Resend > Domains.
EMAIL_FROM="KP & Sons Wholesale <info@kpsonswholesale.com>"
# Optional: where customer replies go (defaults to the From address).
EMAIL_REPLY_TO=info@kpsonswholesale.com
# Staff address(es) for new-application alerts; comma-separated for several.
ADMIN_NOTIFICATION_EMAIL=info@kpsonswholesale.com
